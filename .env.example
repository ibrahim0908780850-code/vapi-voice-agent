# HTTP and deployment
PORT=8080
NODE_ENV=production
BASE_URL=https://your-backend.example.com
FRONTEND_URL=https://salih-ai-one.vercel.app

# Core authentication and database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
PLATFORM_OWNER_EMAIL=owner@example.com

# Background jobs
REDIS_URL=redis://localhost:6379

# AI and channel integrations
GEMINI_API_KEY=replace-with-provider-key
GEMINI_MODEL=gemini-2.0-flash
WHATSAPP_API_URL=https://graph.facebook.com/...
SENDGRID_API_KEY=replace-with-sendgrid-key

# Development-only tenant header. Never enable in production.
ALLOW_UNSAFE_TENANT_HEADER=false
